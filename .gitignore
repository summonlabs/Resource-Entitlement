# Resource Entitlement - .gitignore
# Build output, CMake state, compiled artifacts, and editor/OS clutter.

# --- Build output directories -------------------------------------------------
build/
build-*/
out/
out-*/
cmake-build-*/

# --- CMake user and generated state ------------------------------------------
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake

# --- Visual Studio project files generated by CMake --------------------------
INSTALL.vcxproj*
*.vcxproj*
*.sln
.vs/

# --- Compiled artifacts -------------------------------------------------------
*.obj
*.o
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp

# --- Editor and OS clutter ----------------------------------------------------
.vscode/
.idea/
Thumbs.db
Desktop.ini
